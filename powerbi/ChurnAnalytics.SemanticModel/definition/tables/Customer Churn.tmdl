/// Final customer churn status in a synthetic four-quarter attrition scenario; not observed historical performance.
table 'Customer Churn'
	lineageTag: a530fb45-9668-4820-aba5-79d8dcdc0dc4

	/// Distinct customers in the current filter context.
	measure 'Total Customers' = DISTINCTCOUNT('Customer Churn'[customerID])
		formatString: #,##0
		lineageTag: 8e730997-30d6-4c91-b76c-7f28f251c554

	/// Distinct customers marked as churned.
	measure 'Churned Customers' = CALCULATE([Total Customers], 'Customer Churn'[Churn] = "Yes")
		formatString: #,##0
		lineageTag: 4763421e-e410-45c9-a09c-4bcf49c87d54

	/// Share of customers marked as churned.
	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers], 0)
		formatString: 0.0%
		lineageTag: 21d871a6-a311-468a-9336-5d920c0f88ef

	/// Monthly charges associated with customers marked as churned.
	measure 'Monthly Revenue at Risk' = CALCULATE(SUM('Customer Churn'[MonthlyCharges]), 'Customer Churn'[Churn] = "Yes")
		formatString: $#,##0
		lineageTag: f8f648e9-b020-4515-8549-760916746458

	/// Average monthly charges in the current filter context.
	measure 'Average Monthly Charges' = AVERAGE('Customer Churn'[MonthlyCharges])
		formatString: $#,##0.00
		lineageTag: dd4ac1a2-9e5f-4762-abe3-7c193474c376

	/// Average tenure in months in the current filter context.
	measure 'Average Tenure (Months)' = AVERAGE('Customer Churn'[tenure])
		formatString: 0.0
		lineageTag: dec2962a-a726-4a8c-ae43-8b9603a2053c

	/// Distinct customers not marked as churned.
	measure 'Retained Customers' = [Total Customers] - [Churned Customers]
		formatString: #,##0
		lineageTag: 3452ac87-a5f6-4e69-aa10-43bfa542bd90

	column customerID
